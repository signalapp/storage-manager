{
  "name": "storage-manager",
  "version": "0.4.9",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.59.2"
  },
  "dependencies": {
    "itty-router": "^5.0.24"
  },
  "private": true,
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler publish",
